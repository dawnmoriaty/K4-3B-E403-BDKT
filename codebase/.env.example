# Copy values to .env locally. Never commit the real key.
AI_PROVIDER=openai
AI_API_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4o-mini
AI_API_KEY=
# Hybrid retrieval uses the OpenAI-compatible embeddings endpoint. Set to off for BM25-only mode.
AI_EMBEDDING_MODEL=text-embedding-3-small
# Optional when embeddings are served by a different endpoint or credential.
# AI_EMBEDDING_API_URL=https://api.openai.com/v1/embeddings
# AI_EMBEDDING_API_KEY=
# AI_EMBEDDING_DIMENSIONS=1536
AI_EMBEDDING_BATCH_SIZE=64
SEMANTIC_GATE_THRESHOLD=0.35
# Restricted local data pack. The pack is read in memory and never copied into this repo.
VLEARN_PACK_PATH=C:\Users\your-name\Downloads\K4-3B-Day05-06-AI-Product-Hackathon-main\K4-3B-Day05-06-AI-Product-Hackathon-main\data\vlearn-pack
